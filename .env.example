# Calendly. Blank uses the default from src/lib/env.ts; "off" disables that link.
# Profile page (student picks the event type) or a single event link.
# Default: https://calendly.com/asanichols07
NEXT_PUBLIC_CALENDLY_URL=
# Per-type event links. Types without a link open the profile page.
# Default: https://calendly.com/asanichols07/60min
NEXT_PUBLIC_CALENDLY_URL_60=
# Default: https://calendly.com/asanichols07/30min
NEXT_PUBLIC_CALENDLY_URL_30=
# Default: https://calendly.com/asanichols07/60min-1
NEXT_PUBLIC_CALENDLY_URL_GROUP=
# Set all four NEXT_PUBLIC_CALENDLY_URL* variables to off to use the in-app form.

# Supabase. Leave blank to use the local catalog + in-memory bookings.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

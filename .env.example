# Calendly. Leave all blank to use the in-app booking form.
# Profile page (student picks the event type) or a single event link.
NEXT_PUBLIC_CALENDLY_URL=
# Optional per-type event links. Any that are set show a session-type picker on /book.
NEXT_PUBLIC_CALENDLY_URL_60=
NEXT_PUBLIC_CALENDLY_URL_30=
NEXT_PUBLIC_CALENDLY_URL_GROUP=

# Supabase. Leave blank to use the local catalog + in-memory bookings.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

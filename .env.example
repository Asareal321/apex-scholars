# Public site origin. Required on Vercel so Stripe returns to the right domain.
# Local fallback is http://127.0.0.1:4327
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4327

# Stripe Checkout. Leave blank to use /checkout/mock (no charges).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Calendly event URL. Leave blank to use the in-app booking form on /book.
NEXT_PUBLIC_CALENDLY_URL=

# Supabase. Leave blank to use the local catalog + in-memory bookings/payments.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
